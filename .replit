modules = ["nodejs-20", "web", "postgresql-16"]
run = "npm run dev"
hidden = [".config", "dist", "node_modules"]

[nix]
channel = "stable-24_05"

[env]
PORT = "5000"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm install --include=dev && npm run build"]
run = ["sh", "-c", "npm start"]

[workflows]
runButton = "Avvia Dog's Planet"

[[workflows.workflow]]
name = "Avvia Dog's Planet"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm install && npm run dev"
waitForPort = 5000
