# Su Replit questi valori vanno nei "Secrets" (variabili protette), MAI in questo file o su GitHub.
DATABASE_URL=postgres://user:password@host:5432/db
SESSION_SECRET=una-stringa-lunga-e-casuale
PUBLIC_URL=https://tuo-dominio.it
# Primo amministratore (username "Admin"): creato solo se questa variabile esiste. Cambio password obbligatorio al primo accesso.
ADMIN_INITIAL_PASSWORD=
ADMIN_EMAIL=dogsplanetcernusco@gmail.com
# Email (SMTP) – senza, le email restano in coda come "simulate"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Dog's Planet <dogsplanetcernusco@gmail.com>"
# Notifiche push (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Pagamenti online (Stripe Checkout) – facoltativo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Storage file: bucket Replit Object Storage (altrimenti cartella locale ./uploads, non persistente nei deploy)
REPLIT_OBJECT_BUCKET=
