# Su Replit impostare questi valori in "Secrets" (variabili protette), NON in questo file.
DATABASE_URL=postgres://user:password@host:5432/db
SESSION_SECRET=una-stringa-lunga-e-casuale
PUBLIC_URL=https://tuo-dominio.it
# Primo amministratore (usato solo dal seed se non esiste alcun admin)
ADMIN_EMAIL=dogsplanetcernusco@gmail.com
ADMIN_PASSWORD=cambiami-subito
# Email (SMTP) – se assenti le email vengono solo registrate nel log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Dog's Planet <dogsplanetcernusco@gmail.com>"
# Notifiche push (genera con: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Pagamenti online (Stripe Checkout) – facoltativo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Storage file: se presente usa Replit Object Storage, altrimenti cartella locale ./uploads
REPLIT_OBJECT_BUCKET=
